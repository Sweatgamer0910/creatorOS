generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts under Prisma v7's config
  // system, not here — declaring `url` or `directUrl` in this file errors
  // with P1012 ("no longer supported in schema files") under Prisma 7.8.0.
  // DATABASE_URL points at Neon's pooled endpoint as of 2026-07-30; a
  // directUrl-style split (pooled for the app, direct for migrate) isn't
  // available in this Prisma version's config.datasource type (@prisma/
  // config only exposes `url`/`shadowDatabaseUrl`, not `directUrl`) — not
  // needed in practice either, since `prisma migrate deploy` has run clean
  // through the pooled connection every time so far. See
  // docs/DEVELOPMENT_LOG.md, 2026-07-30.
}

// ===== Better Auth required tables =====

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Set once, by the completeOnboarding server action, when the Nova tour
  // is finished or skipped — null means "hasn't seen it yet" and drives
  // the auto-launch check in OnboardingTourHost.
  onboardingCompletedAt DateTime?

  // Referral loop (see src/lib/referral.ts). referralCode is generated once
  // in the databaseHooks.user.create.after hook (src/lib/auth.ts) — a short
  // random code, not the row's own cuid, so the shared URL
  // (creatoros.onl/?ref=<code>) is shorter and doesn't leak the user's
  // internal row id. referredByCode is set at that same signup moment from
  // a short-lived `co_ref` cookie (src/components/ReferralCapture.tsx) if
  // the visitor arrived via someone else's link — never changed after,
  // even if the referrer later changes their own code (they can't, but if
  // that ever becomes possible, attribution should stay pinned to what was
  // true at signup).
  // Nullable (not required + defaulted) on purpose: a required unique
  // column with no natural default would force an interactive backfill
  // decision the first time this migrates against a table that already has
  // real user rows (which it does — this isn't a fresh dev database). Null
  // just means "hasn't been lazily assigned one yet" — see
  // getOrCreateReferralCode in src/lib/referral.ts, which every real read
  // path goes through instead of reading the column directly.
  referralCode   String? @unique
  referredByCode String?

  sessions  Session[]
  accounts  Account[]
  workspace Workspace?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ===== CreatorOS app tables =====

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Free-text-ish string (same convention as ContentItem.status /
  // Series.cadence — small fixed set enforced in TypeScript, not the
  // database). Everyone is "free" today since there's no billing yet (see
  // docs/DECISIONS_LOG.md, 2026-07-28) — this field exists so a future
  // paid tier has somewhere to land without another migration, and so the
  // Resend audience sync can segment broadcasts by plan from day one.
  plan String @default("free")

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  channels     Channel[]
  ideas        Idea[]
  scripts      Script[]
  contentItems ContentItem[]
  series       Series[]

  @@map("workspace")
}

model Channel {
  id               String   @id @default(cuid())
  youtubeChannelId String   @unique
  title            String
  thumbnailUrl     String?
  connectedAt      DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  snapshots ChannelSnapshot[]

  @@map("channel")
}

model ChannelSnapshot {
  id               String   @id @default(cuid())
  capturedAt       DateTime @default(now())
  subscriberCount  Int
  viewCount        Int
  videoCount       Int
  watchTimeMinutes Int?

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_snapshot")
}

model Idea {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Optional position within a series — e.g. "Part 3" of an ongoing
  // series. Both null for an idea that isn't part of a series.
  seriesId      String?
  series        Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  episodeNumber Int?

  scripts      Script[]
  contentItems ContentItem[]

  @@map("idea")
}

model Series {
  id          String   @id @default(cuid())
  title       String
  description String?
  // Free-text-ish string, not a Prisma enum — same convention as
  // ContentItem.status/PipelineStatus: a small fixed set of values
  // enforced in TypeScript (see src/lib/series/actions.ts), not the
  // database. "custom" covers anything outside the common presets.
  cadence     String? // daily | weekly | biweekly | custom
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ideas Idea[]

  @@map("series")
}

model Script {
  id        String   @id @default(cuid())
  title     String
  hook      String   @default("") @db.Text
  intro     String   @default("") @db.Text
  body      String   @default("") @db.Text
  outro     String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Manual per-section completeness — deliberately not inferred from word
  // count (too often wrong), set only by the writer clicking "mark done".
  hookComplete  Boolean @default(false)
  introComplete Boolean @default(false)
  bodyComplete  Boolean @default(false)
  outroComplete Boolean @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  contentItems ContentItem[]
  versions     ScriptVersion[]

  @@map("script")
}

model ScriptVersion {
  id        String   @id @default(cuid())
  hook      String   @db.Text
  intro     String   @db.Text
  body      String   @db.Text
  outro     String   @db.Text
  createdAt DateTime @default(now())

  scriptId String
  script   Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("script_version")
}

// Pre-launch email capture from the landing page's ClosingCTA form —
// deliberately its own table rather than only living in Resend, so the list
// survives independent of that integration (Resend sync in
// src/lib/waitlist/actions.ts is best-effort, this table is the source of
// truth). No workspace/user relation: these people haven't signed up yet.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist_entry")
}

// One row per free Channel Health check where the visitor opted in for
// follow-up tips (src/app/channel-health) — email is deliberately NOT
// unique, since the same person can reasonably check multiple channels
// over time and each check is worth recording for lead context. The
// nurture sequence itself (src/lib/inngest/channelCheckNurture.ts) is
// deduped at the application layer instead (only fires once per email —
// see src/lib/channel-health-preview/leadCapture.ts), so checking a
// second channel doesn't start a second overlapping email sequence.
model ChannelCheckLead {
  id           String   @id @default(cuid())
  email        String
  channelTitle String
  score        Int
  createdAt    DateTime @default(now())

  @@map("channel_check_lead")
}

model ContentItem {
  id        String    @id @default(cuid())
  title     String
  status    String    @default("idea") // idea | scripted | filming | editing | published — see src/lib/pipeline/stages.ts
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Optional trace back to where this card came from — set when a card is
  // created "from" an idea or script rather than typed fresh. Both SetNull
  // so deleting the source idea/script never takes the pipeline card with it.
  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  scriptId String?
  script   Script? @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@map("content_item")
}
